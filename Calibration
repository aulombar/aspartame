absorbance_cal <- c(0.173, 0.232, 0.580, 1.163, 1.754, 2.241, 2.609)
concentration_cal <- c(0.5, 1, 2, 4, 6, 8, 10)

plot(x = concentration_cal, y = absorbance_cal,
	main = "Calibration Curve",
	xlab = "Concentration (mM)",
	ylab = "Absorbance",
	pch = 10,
	col = "black",
	cex = 1,)

model <- lm(absorbance_cal ~ concentration_cal)
abline(model, 
	col = "red", 
	lwd=2)
