concentration <- c(1.56, 3.12, 3.12, 3.12)
absorbance <- c(0.201, 0.377, 2.385, 1.878)
cal_model <- lm(absorbance ~ concentration)

plot(
	concentration, absorbance,
	type = "b", 
	lty = "dashed", 
	pch = 16, 
	col = "darkblue", 
	main = "Concentration Curve", 
	xlab = "Concentration mM", 
	ylab = "Absorbance", las = 1)

abline(
	cal_model, 
	col = "red", 
	lwd = 2, 
	lty = "solid")

legend("topleft", 
	legend = c("Concentration Data", "Linear Regression"), 
	col = c("darkblue", "red"), 
	lty = c("dashed", "solid"), 
	pch = c(16, NA), 
	lwd = c(1, 2))
